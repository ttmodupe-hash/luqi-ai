# =============================================================================
# LUQI AI — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Core -------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8080
WORKERS=1

# --- Security (MUST change before going live!) ------------------------------
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=change-me-to-a-256-bit-secret-key
# Generate a strong admin password or leave empty for auto-generated
ADMIN_PASSWORD=
# CORS origins (comma-separated)
CORS_ORIGINS=https://luqi.ai,https://www.luqi.ai,https://app.luqi.ai

# --- AI Services ------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# --- Analytics (optional but recommended) -----------------------------------
POSTHOG_KEY=phc_...
GA_ID=G-...

# --- Email (optional — for password reset, notifications) -------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@luqi.ai

# --- Feature Flags ----------------------------------------------------------
ENABLE_SANDBOX=true
ENABLE_VOICE=true
ENABLE_WEBSOCKET=true
LOG_TO_FILE=true
LOG_LEVEL=INFO
