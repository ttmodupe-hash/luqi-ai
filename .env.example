# =============================================================================
# LUQI AI Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# WARNING: Never commit .env to version control. It contains secrets!
#
# Configuration categories:
#   - Application    : General app settings (name, version, debug, logging)
#   - Database       : PostgreSQL connection pool settings
#   - Redis          : Cache and pub/sub configuration
#   - Celery         : Distributed task queue settings
#   - Security       : JWT, passwords, rate limiting, MFA
#   - AI/LLM         : OpenAI, Anthropic, Nemotron API configuration
#   - Frontend       : CORS and frontend URL
#   - Monitoring     : Prometheus metrics, Sentry error tracking
#   - Scaling        : Worker counts, timeouts
# =============================================================================

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=LUQI AI
APP_VERSION=29.1.0
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# Format: postgresql+asyncpg://user:password@host:port/database
# The +asyncpg prefix enables async SQLAlchemy engine.
# For Alembic sync migrations, the +asyncpg driver is auto-removed.
DATABASE_URL=postgresql+asyncpg://luqi:password@postgres:5432/luqi_ai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=300

# =============================================================================
# CELERY (Distributed Task Queue)
# =============================================================================
# Broker (queue) and result backend use separate Redis DBs to avoid conflicts.
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=4

# =============================================================================
# SECURITY
# =============================================================================
# JWT_SECRET: Must be >= 32 characters. Generate with:
#   openssl rand -base64 48
JWT_SECRET=change-me-in-production-use-32-char-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin user password (bcrypt hashed in DB; this is the initial seed value)
ADMIN_PASSWORD=change-me

# Rate limiting: max requests per minute per IP/user
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# AI / LLM PROVIDERS
# =============================================================================
# OpenAI (GPT-4o, GPT-4o-mini, embeddings)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude 3.5 Sonnet, etc.)
ANTHROPIC_API_KEY=sk-ant-...

# NVIDIA Nemotron 3.5 Lightning
# Set ENABLE_NEMOTRON=true to enable local/self-hosted Nemotron inference
ENABLE_NEMOTRON=false
NEMOTRON_API_KEY=not-needed-for-local
NEMOTRON_BASE_URL=http://localhost:8000/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning

# =============================================================================
# FRONTEND / CORS
# =============================================================================
# The public URL of the React frontend
FRONTEND_URL=https://luqi.ai

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=https://luqi.ai,https://app.luqi.ai

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Enable Prometheus metrics endpoint
ENABLE_METRICS=true
METRICS_ENDPOINT=/metrics

# Sentry DSN for error tracking (leave empty to disable)
# Get yours at: https://sentry.io/settings/projects/
SENTRY_DSN=

# =============================================================================
# SCALING & PERFORMANCE
# =============================================================================
# Number of Gunicorn worker processes (typically 2-4 x CPU cores)
MAX_WORKERS=4

# Request timeout in seconds (Gunicorn + Uvicorn)
REQUEST_TIMEOUT=30
