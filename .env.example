# =====================================================================
# LUQI AI — Environment Configuration
# Copy to .env and fill in your values
# =====================================================================

# ── Server ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── App Identity ─────────────────────────────────────────────────────
APP_ID=luqi-ai
APP_SECRET=your-secure-secret-here

# ── Database (MySQL) ───────────────────────────────────────────────
DATABASE_URL=mysql://luqi:your_password@localhost:3306/luqi

# ── Redis (optional) ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AI Providers ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key
ANTHROPIC_API_KEY=sk-ant-your-key
GEMINI_API_KEY=your-key

# ── Search ─────────────────────────────────────────────────────────
SERPER_API_KEY=your-key

# ── Notifications ──────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
EMAIL_API_KEY=
EMAIL_FROM=alerts@luqi.ai
ALERT_EMAIL_TO=
SELF_HEALING_WEBHOOK_URL=
