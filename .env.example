# LUQI AI v29.3.0 configuration — copy to .env and fill in. All keys OPTIONAL:
# the engine boots and runs fully offline without them, degrading gracefully.

# OpenAI — enables LLM-enhanced answers (tax, research synthesis) and the claude_engine bridge
OPENAI_API_KEY=

# Serper (https://serper.dev) — enables live deep web research
SERPER_API_KEY=

# OpenRouter (https://openrouter.ai) — enables `evolve run online` (LLM-proposed mutations)
OPENROUTER_API_KEY=
# Model used for online evolution proposals (default: openai/gpt-4o-mini)
OPENROUTER_MODEL=

# Anthropic (optional) — becomes the automatic fallback provider when the claude_engine
# bridge is installed (pip install -e . from the claude_engine repo)
ANTHROPIC_API_KEY=

# Model used by the engine's LLM calls (default: gpt-4o-mini)
OMEGA_LLM_MODEL=

# GitHub auto-sync for `sync github` command
# Format: owner/repo  (e.g. ttmodupe-hash/luqi-ai)
GITHUB_REPO=
# Personal access token — masked in all engine output, never printed in full
GITHUB_TOKEN=

# v29.6.0 optional media tuning (defaults work fine)
OMEGA_TTS_VOICE=alloy
OMEGA_IMAGE_MODEL=dall-e-3

# v29.10.0: travel toolkit (optional)
OMEGA_MAP_PROVIDER=osm
OMEGA_CITY=
