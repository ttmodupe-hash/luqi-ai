{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@contracts/*": [
        "contracts/*"
      ]
    }
  },
  "include": [
    "api/boot.ts",
    "contracts/p2p.ts",
    "src/components/SovereignP2PMessenger.tsx",
    "src/components/P2PAbuseLedger.tsx",
    "app/src/components/SovereignP2PMessenger.tsx",
    "app/src/components/P2PAbuseLedger.tsx",
    "src/App.tsx",
    "app/src/App.tsx"
  ]
}
