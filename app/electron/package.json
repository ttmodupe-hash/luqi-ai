{
  "name": "luqi-ai-desktop",
  "version": "3.6.0",
  "description": "Luqi-AI Desktop \u2014 Windows, macOS, Linux",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "npm run prepare:ui && electron-builder",
    "build:win": "npm run prepare:ui && electron-builder --win",
    "build:mac": "npm run prepare:ui && electron-builder --mac",
    "build:linux": "npm run prepare:ui && electron-builder --linux",
    "dist": "npm run prepare:ui && electron-builder --publish=never",
    "prepare:ui": "node -e \"require('node:fs').cpSync('../dist/public', 'ui', {recursive:true})\""
  },
  "build": {
    "appId": "com.luqiai.desktop",
    "productName": "Luqi-AI",
    "directories": {
      "output": "../release",
      "buildResources": "../public"
    },
    "files": [
      "main.js",
      "preload.js",
      "ui/**/*"
    ],
    "extraResources": [
      {
        "from": "../public",
        "to": "public"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "../public/icon-512.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../public/icon-512.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Office",
      "icon": "../public/icon-512.png",
      "executableName": "luqi-ai"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "@electron/asar": "4.3.1",
    "@electron/universal": "3.0.6",
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  }
}
