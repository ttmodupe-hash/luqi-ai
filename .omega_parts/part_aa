def _clean_learning_entry(raw: Dict[str, Any]) -> Optional[Dict[str, Any]]:
    """Validate one learner-profile subject entry. None when unusable."""
    try:
        syllabus = []
        for item in raw.get("syllabus") or []:
            if not isinstance(item, dict):
                continue
            title = str(item.get("title", "")).strip()
            points = [str(p) for p in (item.get("points") or [])]
            if title:
                syllabus.append({"title": title, "points": points})
        quiz_scores = []
        for item in raw.get("quiz_scores") or []:
            if not isinstance(item, dict):
                continue
            quiz_scores.append({
                "ts": str(item.get("ts", "")),
                "score": int(item.get("score", 0)),
                "total": int(item.get("total", 0)),
            })
        weak_points = [str(p) for p in (raw.get("weak_points") or [])]
        try:
            current_lesson = max(0, int(raw.get("current_lesson", 0)))
        except Exception:
            current_lesson = 0
        return {
            "syllabus": syllabus,
            "current_lesson": current_lesson,
            "quiz_scores": quiz_scores,
            "weak_points": weak_points,
            "started": str(raw.get("started", "")),
            "last_session": str(raw.get("last_session", "")),
        }
    except Exception:
        return None


