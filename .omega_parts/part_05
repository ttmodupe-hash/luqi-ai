        try:
            body = json.dumps({
                "model": self.image_model,
                "prompt": (prompt or "")[:1000],
                "n": 1,
                "size": IMAGE_SIZE,
                "response_format": "b64_json",
            }).encode("utf-8")
            request = urllib.request.Request(
                OPENAI_IMAGES_URL,
                data=body,
                headers={
                    "Authorization": "Bearer " + self.openai_key,
                    "Content-Type": "application/json",
