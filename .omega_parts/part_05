    # ------------------------------------------------------------------

    def _bridge_llm_messages(self,
                             messages: List[Dict[str, str]]) -> Optional[str]:
        """Bridge path for a messages list.

        The claude_engine bridge exposes a single-string chat(); the
        rolling context is serialized into one transcript prompt so the
        professor still sees the full conversation. None on ANY issue.
        """
        try:
            bridge = self._get_bridge()
            if bridge is None:
                return None
            parts = []
            for msg in messages:
                role = str(msg.get("role", "user"))
                content = str(msg.get("content", ""))
                if role == "system":
                    parts.append("System: " + content)
                elif role == "assistant":
                    parts.append("Professor: " + content)
                else:
                    parts.append("Student: " + content)
            parts.append("Professor:")
            reply = bridge.chat("\n\n".join(parts))
            if isinstance(reply, str):
                return reply if reply.strip() else None
            if isinstance(reply, dict):
                content = reply.get("content") or reply.get("text")
                if content:
                    return str(content)
            if reply:
                return str(reply)
            return None
        except Exception:
            return None

    def _llm_messages(self, messages: List[Dict[str, str]],
                      max_tokens: int = 700) -> Optional[str]:
        """Chat-completions call with a full messages list.

        Bridge-first (when installed), stdlib urllib fallback. Returns
        None without a key or on ANY failure - callers must fall back
        gracefully and never fake a reply.
        """
        clean = []
        for msg in messages:
            role = str(msg.get("role", "user"))
            if role not in ("system", "user", "assistant"):
                role = "user"
            clean.append({"role": role,
                          "content": str(msg.get("content", ""))})
        if not clean:
            return None
        # v29.6.0: OpenRouter fallback prompt (last user message, else last).
        fallback_prompt = clean[-1]["content"]
        for msg in reversed(clean):
            if msg["role"] == "user":
                fallback_prompt = msg["content"]
                break
        if not self.openai_key:
            # v29.6.0: OpenRouter fallback also works without an OpenAI key.
            return self._openrouter_chat(fallback_prompt)
        if BRIDGE_AVAILABLE:
            bridged = self._bridge_llm_messages(clean)
            if bridged:
                return bridged
            # Bridge failed -> fall through to the urllib path.
        try:
            body = json.dumps({
                "model": OPENAI_MODEL,
                "messages": clean,
                "max_tokens": max_tokens,
            }).encode("utf-8")
            request = urllib.request.Request(
                OPENAI_URL,
                data=body,
                headers={
                    "Authorization": "Bearer " + self.openai_key,
                    "Content-Type": "application/json",
                },
                method="POST",
            )
            with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT) as resp:
                data = json.loads(resp.read().decode("utf-8", errors="replace"))
            choices = data.get("choices") or []
            if not choices:
                return self._openrouter_chat(fallback_prompt)
            message = choices[0].get("message") or {}
            content = message.get("content")
            if content:
                return str(content)
            # v29.6.0: empty OpenAI reply -> OpenRouter fallback.
            return self._openrouter_chat(fallback_prompt)
        except Exception:
            # v29.6.0: OpenRouter is the final fallback before None.
            return self._openrouter_chat(fallback_prompt)

