    def dataset_note(self) -> Optional[str]:
        """One-line note for tax/mine subsystems when a dataset is loaded."""
        if self.dataset:
            return ("Dataset note: %d rows from '%s' are loaded and "
                    "available for analysis." % (
                        len(self.dataset.get("rows", [])),
