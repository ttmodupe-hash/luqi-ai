        return None

    def _restore_last_import(self) -> None:
        """Reload the dataset referenced by memory datasets.last_import."""
        try:
            datasets = self.memory.get("datasets") or {}
            meta = datasets.get("last_import")
            if not isinstance(meta, dict):
                return
            path = str(meta.get("path") or "")
            if path and os.path.isfile(path):
                ok, _msg = self.import_dataset(path, save=False)
                if not ok:
                    self.dataset = None
        except Exception:
            self.dataset = None

    def import_dataset(self, path: str, save: bool = True) -> Tuple[bool, str]:
        """Load a .csv or .xlsx dataset. Returns (ok, message). Never raises."""
        try:
            path = str(path or "").strip()
            if not path:
                return False, "Usage: import <path-to-csv-or-xlsx>"
            if not os.path.isfile(path):
                return False, "File not found: %s" % path
            ext = os.path.splitext(path)[1].lower()
            if ext == ".csv":
                headers, rows = _read_csv_dataset(path)
            elif ext == ".xlsx":
                headers, rows = _read_xlsx_dataset(path)
            else:
                return False, ("Unsupported extension '%s'. Only .csv and "
                               ".xlsx are supported." % (ext or "(none)"))
            if not headers:
                return False, "No header row found in %s." % path
            if len(rows) > MAX_DATASET_ROWS:
                return False, ("Dataset has %d rows; the limit is %d. "
                               "Import refused." % (len(rows), MAX_DATASET_ROWS))
            self.dataset = {
                "path": os.path.abspath(path),
                "name": os.path.basename(path),
                "source": ext.lstrip("."),
                "headers": headers,
                "rows": rows,
            }
            self.memory.setdefault("datasets", {})["last_import"] = {
                "path": os.path.abspath(path),
                "name": os.path.basename(path),
                "source": ext.lstrip("."),
                "rows": len(rows),
                "columns": len(headers),
                "headers": headers,
                "ts": utc_now_iso(),
            }
            if save:
                save_memory(self.memory_path, self.memory)
            return True, ("Imported %d row(s) x %d column(s) from %s "
                          "(%s)." % (len(rows), len(headers),
                                     os.path.basename(path), ext.lstrip(".")))
        except Exception as exc:
            return False, "Import failed safely: %s" % exc

    def _store_document(self, name: str, origin: str, text: str,
                        save: bool = True) -> Tuple[bool, str]:
        """Chunk and store one document (dedup by name, evict to caps).

        Shared by file and URL ingestion. Never raises.
        """
        try:
            chunks = _chunk_text(text)
            if not chunks:
                return False, "no text content found"
            docs = self.memory.setdefault("documents", [])
            if not isinstance(docs, list):
                docs = []
                self.memory["documents"] = docs
            # Re-ingest of the same name replaces the old entry.
            docs[:] = [d for d in docs
                       if not isinstance(d, dict)
                       or str(d.get("name", "")).lower() != name.lower()]
            docs.append({"name": name,
                         "path": origin,
                         "chars": len(text),
                         "chunks": chunks,
                         "ts": utc_now_iso()})
            # Evict oldest docs beyond the cap, then trim the oldest doc
            # chunk-by-chunk until the global chunk budget fits again.
            while len(docs) > MAX_DOCUMENTS:
                docs.pop(0)
            while (docs and sum(len(d.get("chunks") or []) for d in docs
                                if isinstance(d, dict)) > MAX_TOTAL_CHUNKS):
                oldest = docs[0]
                if (isinstance(oldest, dict)
                        and len(oldest.get("chunks") or []) > 1):
                    oldest["chunks"].pop()
                else:
                    docs.pop(0)
            if save:
                save_memory(self.memory_path, self.memory)
            return True, ("ingested: %s (%d chunks, %d chars)"
                          % (name, len(chunks), len(text)))
        except Exception as exc:
            return False, "ingest failed safely: %s" % exc

    def import_document(self, path: str, save: bool = True) -> Tuple[bool, str]:
        """Ingest a text document into the persistent store. Never raises."""
        try:
            path = str(path or "").strip()
            if not path:
                return False, "usage: ingest <path>"
            if not os.path.isfile(path):
                return False, "file not found: %s" % path
            ext = os.path.splitext(path)[1].lower()
            if ext not in (".txt", ".md", ".csv", ".log", ".json",
                           ".docx", ".xlsx"):
                return False, ("unsupported type %s (use .txt .md .csv "
                               ".log .json .docx .xlsx)"
                               % (ext or "(none)"))
            size = os.path.getsize(path)
            if size > MAX_DOCUMENT_BYTES:
                return False, ("file too large (%d bytes > %d cap)"
                               % (size, MAX_DOCUMENT_BYTES))
            if ext in (".csv", ".xlsx"):
                # CSV/XLSX ingest as rendered rows so Q&A can quote them.
                if ext == ".csv":
                    headers, rows = _read_csv_dataset(path)
                else:
                    headers, rows = _read_xlsx_dataset(path)
                lines = []
                if headers:
                    lines.append(" | ".join(str(h) for h in headers))
                for row in rows:
                    lines.append(" | ".join(str(c) for c in row))
                text = "\n".join(lines)
            elif ext == ".docx":
                text = _docx_to_text(path)
            else:
                with open(path, "r", encoding="utf-8",
                          errors="replace") as handle:
                    text = handle.read()
            return self._store_document(
                os.path.basename(path), os.path.abspath(path), text, save)
        except Exception as exc:
            return False, "ingest failed safely: %s" % exc

    def import_url(self, url: str, save: bool = True) -> Tuple[bool, str]:
        """Fetch a web page and ingest its visible text. Never raises.

        HTML pages go through _html_to_text; plain text is taken raw;
        other content types are refused. Body is capped at
        MAX_DOCUMENT_BYTES (truncation noted in the message).
        """
        try:
            url = str(url or "").strip()
            if not url.lower().startswith(("http://", "https://")):
                return False, ("unsupported scheme (use http:// or "
                               "https://): %s" % (url or "(empty)"))
            request = urllib.request.Request(
                url, headers={"User-Agent": ("LUQI-AI/29.8 (personal "
                                             "document ingest)")})
            try:
                with urllib.request.urlopen(
                        request, timeout=HTTP_TIMEOUT) as response:
                    raw = response.read(MAX_DOCUMENT_BYTES + 1)
                    content_type = str(response.headers.get(
                        "Content-Type", "")).lower()
            except Exception as exc:
                return False, "fetch failed safely: %s" % exc
            truncated = len(raw) > MAX_DOCUMENT_BYTES
            raw = raw[:MAX_DOCUMENT_BYTES]
            text = raw.decode("utf-8", errors="replace")
            if "html" in content_type:
                text = _html_to_text(text)
            elif content_type and "text" not in content_type:
                return False, ("unsupported content type %s"
                               % (content_type.split(";")[0] or "?"))
            if not text.strip():
                return False, "no text content found"
            base = url.split("://", 1)[1]
            base = base.split("?", 1)[0].split("#", 1)[0].strip("/")
            name = _slugify(base.replace("/", " "))[:40] or "web-page"
            ok, message = self._store_document(name, url, text, save)
            if ok and truncated:
                message = message + (" (truncated at %d bytes)"
                                     % MAX_DOCUMENT_BYTES)
            return ok, message
        except Exception as exc:
            return False, "ingest failed safely: %s" % exc

