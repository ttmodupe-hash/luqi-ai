    def _github_api(self, path: str) -> Optional[Dict[str, Any]]:
        """GET the GitHub REST API; return parsed JSON or None on failure."""
        if not self.github_token:
            return None
        try:
            request = urllib.request.Request(
                GITHUB_API_BASE + str(path),
                headers={
                    "Authorization": "Bearer " + self.github_token,
                    "Accept": "application/vnd.github+json",
                    "User-Agent": "luqi-ai",
                },
                method="GET",
            )
            with urllib.request.urlopen(request,
                                        timeout=GITHUB_API_TIMEOUT) as resp:
                return json.loads(resp.read().decode("utf-8",
                                                     errors="replace"))
        except Exception:
            return None

    def _openrouter_chat(self, prompt: str) -> Optional[str]:
        """Chat-completions POST to OpenRouter; return text or None."""
        if not self.openrouter_key:
            return None
        try:
            body = json.dumps({
                "model": self.openrouter_model,
                "messages": [{"role": "user", "content": prompt}],
                "max_tokens": 512,
            }).encode("utf-8")
            request = urllib.request.Request(
                OPENROUTER_URL,
                data=body,
                headers={
                    "Authorization": "Bearer " + self.openrouter_key,
                    "Content-Type": "application/json",
                },
                method="POST",
            )
            with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT) as resp:
                data = json.loads(resp.read().decode("utf-8", errors="replace"))
            choices = data.get("choices") or []
            if not choices:
                return None
            content = str((choices[0].get("message") or {}).get("content")
                          or "").strip()
            return content or None
        except Exception:
            return None

