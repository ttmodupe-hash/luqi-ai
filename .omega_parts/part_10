= []
    leftover: Optional[str] = None
    while True:
        try:
            if leftover is not None:
                raw = leftover
                leftover = None
            else:
                raw = input_fn("[CLASS:%s] > " % subject)
        except EOFError:
            out("")
            out("(End of input - closing the classroom safely.)")
            break
        except KeyboardInterrupt:
            out("")  # newline, then reprompt
            continue
        cmd = raw.strip().lower()
        if not cmd:
            continue

        if cmd == "end class":
            break
        if cmd == "syllabus":
            for line in syllabus_lines(engine, subject):
                out(line)
            continue
        if cmd == "progress":
            for line in progress_lines(engine):
                out(line)
            continue
        if cmd == "quiz me":
            graded: Optional[Tuple[int, int]] = None
            if online:
                graded = run_online_quiz(engine, subject, messages,
                                         input_fn, out)
                if graded is None:
                    out("Live quiz unavailable - switching to offline "
                        "self-check cards.")
            if graded is None:
                score, asked, leftover = run_offline_quiz(
                    engine, subject, input_fn, out)
                if asked:
                    graded = (score, asked)
            if graded is not None:
                engine.record_quiz_score(subject, graded[0], graded[1])
                out("Quiz score recorded: %d/%d." % graded)
                quiz_results.append(graded)
            continue
        if cmd == "hint":
            if online:
                messages.append({"role": "user", "content": (
                    "I am stuck. Re-explain the current point more "
                    "simply and give me a hint, not the full answer.")})
                messages = _cap_messages(messages)
                reply = engine._llm_messages(messages)
                if reply:
                    reply = reply.strip()
                    out(reply)
                    messages.append({"role": "assistant",
                                     "content": reply})
                else:
                    out("The professor is unreachable right now (LLM "
                        "call failed) - no hint was generated.")
                    for line in lesson_intro_lines(entry, subject):
                        out(line)
            else:
                lesson_lines = lesson_intro_lines(entry, subject)
                if len(lesson_lines) > 1:
                    out("Hint: focus on this key point first - "
                        + lesson_lines[1].strip(" -"))
                else:
                    out("Hint: re-read the lesson title and look up one "
                        "example.")
            continue
        if cmd == "next":
            if entry.get("current_lesson", 0) < len(syllabus) - 1:
                entry["current_lesson"] = int(
                    entry.get("current_lesson", 0)) + 1
                for line in lesson_intro_lines(entry, subject):
                    out(line)
                if online:
                    messages.append({"role": "user", "content": (
                        "Let's move to the next lesson: %s."
                        % syllabus[entry["current_lesson"]].get(
                            "title", ""))})
                    messages = _cap_messages(messages)
                    reply = engine._llm_messages(messages)
                    if reply:
                        reply = reply.strip()
                        out(reply)
                        messages.append({"role": "assistant",
                                         "content": reply})
                    else:
                        out("(Professor unreachable - showing the "
                            "offline key points above.)")
            else:
                out("You are on the final lesson - try 'quiz me' or "
                    "'end class'.")
            continue

        # Free text -> student turn.
        turns += 1
        if online:
            messages.append({"role": "user", "content": raw.strip()})
            messages = _cap_messages(messages)
            reply = engine._llm_messages(messages)
            if reply:
                reply = reply.strip()
                out(reply)
                messages.append({"role": "assistant", "content": reply})
            else:
                out("The professor is unreachable right now (LLM call "
                    "failed) - no reply was generated.")
                out("You can still use: syllabus | next | quiz me | "
                    "hint | progress | end class.")
        else:
            out("(Offline classroom: there is no live conversation "
                "without OPENAI_API_KEY.)")
            out("Review the current lesson key points:")
            for line in lesson_intro_lines(entry, subject):
                out(line)
            out("Type 'next' to advance, 'quiz me' to self-check, or "
                "'end class' to finish.")

    # Session close: summary + persist progress (always, even on EOF).
    entry["last_session"] = utc_now_iso()
    save_memory(engine.memory_path, engine.memory)
    out("-" * 60)
    out("Class summary - %s" % subject)
    out("  Turns this session: %d" % turns)
    total_lessons = len(syllabus) or 10
    out("  Lesson position: %d/%d"
        % (min(int(entry.get("current_lesson", 0)) + 1, total_lessons),
           total_lessons))
    if quiz_results:
        out("  Quiz scores this session: "
            + ", ".join("%d/%d" % q for q in quiz_results))
    else:
        out("  Quiz scores this session: none")
    out("Progress saved to your learner profile ('progress' to view).")
    engine._audit("Classroom", "teach %s" % subject, "Success")
    engine.add_history("assistant",
                       "Taught a %s class (%d turns)." % (subject, turns))


def run_standalone_quiz(engine: OmegaMasterEngine, subject: str,
                        input_fn: Any = input, out: Any = print) -> None:
    """Top-level 'quiz <subject>' command (online grading or self-check)."""
    subject = normalize_subject(subject)
    if not subject:
        out("Usage: quiz <subject>   (inside a class, just say 'quiz me')")
        return
    graded: Optional[Tuple[int, int]] = None
    if engine.openai_key:
        graded = run_online_quiz(
            engine, subject,
            [{"role": "system", "content": PROFESSOR_PROMPT % subject}],
            input_fn, out)
        if graded is None:
            out("Live quiz unavailable - switching to offline "
                "self-check cards.")
    if graded is None:
        score, asked, leftover = run_offline_quiz(engine, subject,
                                                  input_fn, out)
        if leftover:
            out("(Ignored outside a class: '%s')" % leftover)
        if asked:
            graded = (score, asked)
    if graded is not None:
        engine.record_quiz_score(subject, graded[0], graded[1])
        out("Quiz score recorded: %d/%d. See 'progress'." % graded)


