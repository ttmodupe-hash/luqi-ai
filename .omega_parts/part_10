show":
            if not forge:
                print("no prompt draft - start with: prompt <your idea>")
                engine._audit("CLI", "prompt show", "Failed")
                return True
            print(_compile_expert_prompt(str(forge.get("idea", "")),
                                         forge.get("adds") or []))
            engine._audit("CLI", "prompt show", "Success")
            return True
        if first == "run":
            if not forge:
                print("no prompt draft - start with: prompt <your idea>")
                engine._audit("CLI", "prompt run", "Failed")
                return True
            compiled = _compile_expert_prompt(str(forge.get("idea", "")),
                                              forge.get("adds") or [])
            try:
                reply = engine._llm_messages([
                    {"role": "system", "content": compiled},
                    {"role": "user", "content": "Execute the mandate now."},
                ])
            except Exception:
                reply = None
            if reply:
                print(reply.strip())
                engine._audit("CLI", "prompt run", "Success")
            else:
                print("prompt run needs OPENAI_API_KEY in .env - prompt "
                      "is ready above (prompt show)")
                engine._audit("CLI", "prompt run", "Failed")
            return True
        if first == "save":
            if not forge:
                print("no prompt draft - start with: prompt <your idea>")
                engine._audit("CLI", "prompt save", "Failed")
                return True
            try:
                idea = str(forge.get("idea", ""))
                adds = [str(a) for a in (forge.get("adds") or [])]
                compiled = _compile_expert_prompt(idea, adds)
                tips = _prompt_gaps(idea + " " + " ".join(adds))
                stamp = datetime.now(timezone.utc).strftime(
                    "%Y%m%dT%H%M%SZ")
                filename = "omega_prompt_%s_%s.md" % (
                    _slugify(idea), stamp)
                out_lines = [
                    "# Prompt Forge: %s" % idea,
                    "",
                    "Generated: %s (UTC)" % utc_now_iso(),
                    "Engine: " + ENGINE_NAME,
                    "",
                    "## Idea",
                    idea,
                    "",
                    "## Injected requirements",
                ]
                if adds:
                    out_lines.extend("- " + a for a in adds)
                else:
                    out_lines.append("- (none)")
                out_lines.extend(["", "## Compiled expert prompt", "",
                                  compiled, "", "## Coaching tips"])
                if tips:
                    out_lines.extend("- " + t for t in tips)
                else:
                    out_lines.append("- (none - prompt is well formed)")
                out_lines.append("")
                with open(filename, "w", encoding="utf-8") as handle:
                    handle.write("\n".join(out_lines))
                print("saved: %s" % filename)
                engine._audit("CLI", "prompt save", "Success")
            except Exception as exc:
                print("prompt save failed safely: %s" % exc)
                engine._audit("CLI", "prompt save", "Failed")
            return True
        if first == "clear":
            if not forge:
                print("no prompt draft to clear")
                engine._audit("CLI", "prompt clear", "Failed")
                return True
            engine.memory.pop("prompt_forge", None)
            save_memory(engine.memory_path, engine.memory)
            print("prompt draft cleared")
            engine._audit("CLI", "prompt clear", "Success")
            return True
        # Start/replace a session with the idea text; compile + coach.
        idea = arg
        engine.memory["prompt_forge"] = {"idea": idea, "adds": [],
                                         "ts": utc_now_iso()}
        print(_compile_expert_prompt(idea, []))
        tips = _prompt_gaps(idea)
        print()
        if tips:
            print("Coaching tips (%d):" % len(tips))
            for tip in tips:
                print("- " + tip)
        else:
            print("Coaching tips: none - strong prompt.")
        save_memory(engine.memory_path, engine.memory)
        engine._audit("CLI", "prompt %s" % idea[:60], "Success")
        return True

    # Commands with arguments -> routed into the engine.
    def route(domain: str, arg: str) -> None:
        result = engine.execute_omega_subsystem(domain, {"query": arg})
        print_result(result)

    if lowered == "mine":
        route("mining", "mining status")
        return True
    for prefix, domain in (
        ("research", "research"),
        ("tax", "tax"),
        ("companion", "companion"),
        ("opportunities", "opportunity"),
        ("finance", "finance"),
        ("selfimprove", "selfimprove"),
    ):
        if lowered == prefix or lowered.startswith(prefix + " "):
            arg = line[len(prefix):].strip()
            route(domain, arg)
            return True

    # Free text -> master router keyword detection -> generic core fallback.
    result = engine.execute_omega_subsystem(line, {"query": line})
    if result.get("status") == "Unknown":
        print(engine.ui("unknown_command"))
    print_result(result)
    return True


def run_repl(engine: OmegaMasterEngine) -> int:
    print_banner(engine)
    # v29.6.0: fire any due reminders once at REPL start (never raises).
    for reminder_text in _due_reminders(engine):
        print("REMINDER: %s" % reminder_text)
    while True:
        try:
            raw = input("[OMEGA] > ")
        except KeyboardInterrupt:
            print()  # newline, then reprompt
            continue
        except EOFError:
            print("\nOMEGA shutting down (EOF). Stay sovereign.")
            break
        if raw.strip():
            engine.add_history("user", raw)
        try:
            if not handle_command(engine, raw):
                break
        except Exception as exc:  # belt-and-braces: never crash the REPL
            print("[Error] recovered from unexpected failure: %s" % exc)
    # Clean exit (exit/quit or EOF): persist memory.
    save_memory(engine.memory_path, engine.memory)
    return 0


