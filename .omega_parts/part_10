                names = [d.get("name") for d in docs if isinstance(d, dict)]
                evict_ok = (ok and len(docs) == 2
                            and "notes.md" not in names
                            and names == ["notes.txt", "extra.txt"])
                # Chunk budget: trim oldest docs until total fits.
                globals()["MAX_TOTAL_CHUNKS"] = 1
                more_path = os.path.join(tmpdir, "more.txt")
                with open(more_path, "w", encoding="ascii") as handle:
                    handle.write("Another small document about tides.\n")
                ok2, _msg = engine.import_document(more_path, save=False)
                docs = engine.memory.get("documents") or []
                names = [d.get("name") for d in docs if isinstance(d, dict)]
                total = sum(len(d.get("chunks") or [])
                            for d in docs if isinstance(d, dict))
                trim_ok = ok2 and total <= 1 and names == ["more.txt"]
            finally:
                globals()["MAX_DOCUMENTS"] = saved_docs
                globals()["MAX_TOTAL_CHUNKS"] = saved_chunks
            checks.append(("docs: eviction drops oldest beyond cap",
                           evict_ok))
            checks.append(("docs: chunk budget trims oldest first",
                           trim_ok))
    except Exception as exc:
        checks.append(("docs: eviction (exception: %s)" % exc, False))

