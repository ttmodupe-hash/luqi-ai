ine._audit("CLI", "backup", "Success")
        except Exception as exc:
            print("backup failed safely: %s" % exc)
            engine._audit("CLI", "backup", "Failed")
        return True

    # --- v29.7.0 commands (document Q&A) ---
    # (Same pre-router position as the v29.6.0 block above. The
    # 'import doc <path>' and 'forget doc <name>' aliases are handled
    # earlier, at the bare 'import'/'forget' handlers they shadow.)
    if lowered == "ingest" or lowered.startswith("ingest "):
        path = line[len("ingest"):].strip().strip("'\"")
        if not path:
            print("Usage: ingest <path-or-url>  "
                  "(.txt .md .csv .log .json .docx .xlsx or http(s)://...)")
            engine._audit("CLI", "ingest (no path)", "Failed")
            return True
        if path.lower().startswith(("http://", "https://")):
            ok, message = engine.import_url(path)
        else:
            ok, message = engine.import_document(path)
        print(message)
        engine._audit("CLI", "ingest %s" % path,
                      "Success" if ok else "Failed")
        return True
    if lowered == "docs":
        docs = [d for d in engine.memory.setdefault("documents", [])
                if isinstance(d, dict)]
        if not docs:
            print("no documents yet - ingest <path> to add one")
            engine._audit("CLI", "docs", "Success")
            return True
        print("#  name                 chunks    chars  ingested")
        for idx, doc in enumerate(docs, 1):
            chunks = doc.get("chunks") or []
            if not isinstance(chunks, list):
                chunks = []
            try:
                chars = int(doc.get("chars") or 0)
            except Exception:
                chars = 0
            print("%-2d %-20s %6d %8d  %s"
                  % (idx, str(doc.get("name", "?"))[:20], len(chunks),
                     chars, str(doc.get("ts", ""))[:10]))
        total = sum(len(d.get("chunks") or []) for d in docs
                    if isinstance(d.get("chunks") or [], list))
        print("%d documents, %d chunks (max %d docs / %d chunks)"
              % (len(docs), total, MAX_DOCUMENTS, MAX_TOTAL_CHUNKS))
        engine._audit("CLI", "docs", "Success")
        return True
    if lowered == "ask" or lowered.startswith("ask "):
        question = line[len("ask"):].strip()
        if not question:
            print("Usage: ask <question>   (or: ask save; web fallback "
                  "when SERPER_API_KEY set)")
            engine._audit("CLI", "ask (no question)", "Failed")
            return True
        if question.lower() == "save":
            last = getattr(engine, "_last_answer", None)
            if not last:
                print("no answer to save yet")
                engine._audit("CLI", "ask save", "Failed")
                return True
            try:
                stamp = datetime.now(timezone.utc).strftime(
                    "%Y%m%dT%H%M%SZ")
                filename = "omega_answer_%s_%s.md" % (
                    _slugify(str(last.get("q", "question"))), stamp)
                answer_lines = [
                    "# Answer: %s" % last.get("q", ""),
                    "",
                    "Generated: %s (UTC)" % utc_now_iso(),
                    "Engine: " + ENGINE_NAME,
                    "",
                    "## Question",
                    str(last.get("q", "")),
                    "",
                    "## Answer",
                    str(last.get("text", "")),
                    "",
                    "## Sources",
                ]
                sources = last.get("sources") or []
                if sources:
                    answer_lines.extend("- " + str(s) for s in sources)
                else:
                    answer_lines.append("- (none)")
                answer_lines.append("")
                with open(filename, "w", encoding="utf-8") as handle:
                    handle.write("\n".join(answer_lines))
                print("saved: %s" % filename)
                engine._audit("CLI", "ask save", "Success")
            except Exception as exc:
                print("answer save failed safely: %s" % exc)
                engine._audit("CLI", "ask save", "Failed")
            return True
        docs = [d for d in engine.memory.setdefault("documents", [])
                if isinstance(d, dict)]
        if not docs:
            web = _ask_web_fallback(engine, question)
            if web:
                print(web["text"])
                if web["sources"]:
                    print()
                    print("sources: " + ", ".join(web["sources"]))
                engine._last_answer = {"q": question, "text": web["text"],
                                       "sources": web["sources"],
                                       "ts": utc_now_iso()}
                engine._audit("CLI", "ask %s (web)" % question[:60],
                              "Success")
                return True
            print("no documents yet - ingest <path> first")
            print("set SERPER_API_KEY in .env for web-backed answers")
            engine._audit("CLI", "ask %s" % question[:60], "Failed")
            return True
        hits = search_documents(question, docs)
        if not hits:
            web = _ask_web_fallback(engine, question)
            if web:
                print(web["text"])
                if web["sources"]:
                    print()
                    print("sources: " + ", ".join(web["sources"]))
                engine._last_answer = {"q": question, "text": web["text"],
                                       "sources": web["sources"],
                                       "ts": utc_now_iso()}
                engine._audit("CLI", "ask %s (web)" % question[:60],
                              "Success")
                return True
            print("no relevant passages - try different words")
            print("documents: " + ", ".join(
                str(d.get("name", "?")) for d in docs))
            print("set SERPER_API_KEY in .env for web-backed answers")
            engine._audit("CLI", "ask %s" % question[:60], "Failed")
            return True
        passages = []
        for num, (_score, name, chunk_idx, chunk) in enumerate(hits, 1):
            passages.append("[%d] (%s #%d) %s"
                            % (num, name, chunk_idx, chunk))
        block = "\n".join(passages)
        try:
            reply = engine._llm_messages([
                {"role": "system",
                 "content": ("Answer ONLY from the provided passages. "
                             "Cite sources like [name]. If the passages "
                             "do not answer, say so briefly.")},
                {"role": "user",
                 "content": question + "\n\nPassages:\n" + block},
            ])
        except Exception:
            reply = None
        sources = ["%s #%d" % (name, chunk_idx)
                   for _s, name, chunk_idx, _c in hits]
        if reply:
            answer_text = reply.strip()
            print(answer_text)
            print()
            print("sources: " + ", ".join(sources))
        else:
            print("offline mode - top passages:")
            offline_lines = []
            for num, (_score, name, chunk_idx, chunk) in enumerate(
                    hits, 1):
                shown = chunk if len(chunk) <= 600 else chunk[:600] + "..."
                offline_lines.append("[%d] (%s #%d) %s"
                                     % (num, name, chunk_idx, shown))
            answer_text = "\n".join(offline_lines)
            print(answer_text)
            print("set OPENAI_API_KEY in .env for synthesized answers")
        engine._last_answer = {"q": question, "text": answer_text,
                               "sources": sources, "ts": utc_now_iso()}
        engine._audit("CLI", "ask %s" % question[:60], "Success")
        return True

    # Commands with arguments -> routed into the engine.
    def route(domain: str, arg: str) -> None:
        result = engine.execute_omega_subsystem(domain, {"query": arg})
        print_result(result)

    if lowered == "mine":
        route("mining", "mining status")
        return True
    for prefix, domain in (
        ("research", "research"),
        ("tax", "tax"),
        ("companion", "companion"),
        ("opportunities", "opportunity"),
        ("finance", "finance"),
        ("selfimprove", "selfimprove"),
    ):
        if lowered == prefix or lowered.startswith(prefix + " "):
            arg = line[len(prefix):].strip()
            route(domain, arg)
            return True

    # Free text -> master router keyword detection -> generic core fallback.
    result = engine.execute_omega_subsystem(line, {"query": line})
    if result.get("status") == "Unknown":
        print(engine.ui("unknown_command"))
    print_result(result)
    return True


def run_repl(engine: OmegaMasterEngine) -> int:
    print_banner(engine)
    # v29.6.0: fire any due reminders once at REPL start (never raises).
    for reminder_text in _due_reminders(engine):
        print("REMINDER: %s" % reminder_text)
    while True:
        try:
            raw = input("[OMEGA] > ")
        except KeyboardInterrupt:
            print()  # newline, then reprompt
            continue
        except EOFError:
            print("\nOMEGA shutting down (EOF). Stay sovereign.")
            break
        if raw.strip():
            engine.add_history("user", raw)
        try:
            if not handle_command(engine, raw):
                break
        except Exception as exc:  # belt-and-braces: never crash the REPL
            print("[Error] recovered from unexpected failure: %s" % exc)
    # Clean exit (exit/quit or EOF): persist memory.
    save_memory(engine.memory_path, engine.memory)
    return 0


