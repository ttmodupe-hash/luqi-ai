e" or low_args.startswith("done "):
            num = args[len("done"):].strip()
            try:
                index = int(num)
            except ValueError:
                index = 0
            if 1 <= index <= len(reminders):
                reminders[index - 1]["done"] = True
                save_memory(engine.memory_path, engine.memory)
                print("Reminder #%d marked done: %s"
                      % (index, reminders[index - 1].get("text", "")))
                engine._audit("Memory", "remind done %d" % index,
                              "Success")
            else:
                print("No reminder #%s. See 'reminders' for numbers."
                      % (num or "?"))
                engine._audit("Memory", "remind done %s" % (num or "?"),
                              "Failed")
            return True
        when = re.search(r"\s+(in\s+\d+\s*[mhd]|at\s+\d{1,2}:\d{2})\s*$",
                         low_args)
        due = _parse_remind_when(when.group(1)) if when else None
        text = args[:when.start()].strip() if when else ""
        if not text or due is None:
            print("Usage: remind <text> in <N>m|h|d   or   "
                  "remind <text> at HH:MM")
            print("       reminders | remind done <n> | remind clear")
            engine._audit("Memory", "remind (usage)", "Failed")
            return True
        reminders.append({"text": text,
                          "due": due.strftime("%Y-%m-%d %H:%M"),
                          "done": False})
        save_memory(engine.memory_path, engine.memory)
        print("Reminder set for %s: %s"
              % (due.strftime("%Y-%m-%d %H:%M"), text))
        engine._audit("Memory", "remind", "Success")
        return True

    # --- v29.10.0 commands (rights & travel toolkit) ---
    if lowered == "map" or lowered.startswith("map "):
        arg = line[len("map"):].strip()
        if not arg:
            print("Usage: map <place>  |  map dir <a> to <b>")
            print("map provider: %s (options: %s; set OMEGA_MAP_PROVIDER "
                  "in .env)" % (engine.map_provider,
                                ", ".join(sorted(MAP_PROVIDERS))))
            engine._audit("CLI", "map (no place)", "Failed")
            return True
        if arg.lower() == "provider":
            print("map provider: %s" % engine.map_provider)
            print("options: %s (set OMEGA_MAP_PROVIDER in .env)"
                  % ", ".join(sorted(MAP_PROVIDERS)))
            engine._audit("CLI", "map provider", "Success")
            return True
        kind = "place"
        place_a = arg
        place_b = ""
        if lowered.startswith("map dir "):
            body = arg[4:].strip()
            parts = re.split(r"\s+to\s+", body, 1)
            if len(parts) == 2 and parts[0].strip() and parts[1].strip():
                kind = "dir"
                place_a = parts[0].strip().strip("'\"")
                place_b = parts[1].strip().strip("'\"")
            else:
                print("Usage: map dir <from> to <to>")
                engine._audit("CLI", "map dir (bad args)", "Failed")
                return True
        else:
            place_a = place_a.strip("'\"")
        url = _map_url(engine.map_provider, kind, place_a, place_b)
        print(url)
        try:
            if webbrowser.open(url):
                print("(opened in your browser)")
            else:
                print("(browser unavailable - copy the URL above)")
        except Exception:
            print("(browser unavailable - copy the URL above)")
        engine._audit("CLI", "map %s" % arg[:60], "Success")
        return True
    if lowered == "roadblock" or lowered.startswith("roadblock "):
        arg = line[len("roadblock"):].strip()
        if not arg:
            print("Usage: roadblock <where> <note>   "
                  "('roadblocks' lists recent)")
            engine._audit("CLI", "roadblock (no args)", "Failed")
            return True
        blocks = arg.split(None, 1)
        where = blocks[0]
        note = blocks[1] if len(blocks) > 1 else ""
        entries = engine.memory.setdefault("roadblocks", [])
        if not isinstance(entries, list):
            entries = []
            engine.memory["roadblocks"] = entries
        entries.append({"where": where, "note": note,
                        "ts": utc_now_iso()})
        while len(entries) > MAX_ROADBLOCKS:
            entries.pop(0)
        save_memory(engine.memory_path, engine.memory)
        print("roadblock logged: %s - %s (total %d)"
              % (where, note or "(no note)", len(entries)))
        engine._audit("CLI", "roadblock %s" % where[:40], "Success")
        return True
    if lowered == "roadblocks":
        entries = [e for e in
                   engine.memory.setdefault("roadblocks", [])
                   if isinstance(e, dict)]
        if not entries:
            print("no roadblocks logged yet - "
                  "roadblock <where> <note> to add one")
        else:
            print("recent roadblocks (newest first):")
            for num, entry in enumerate(reversed(entries[-10:]), 1):
                print("%-2d %-16s %-40s %s"
                      % (num, str(entry.get("where", "?"))[:16],
                         str(entry.get("note", ""))[:40],
