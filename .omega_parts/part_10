    if lowered == "remind" or lowered.startswith("remind "):
        args = line[len("remind"):].strip()
        reminders = engine.memory.setdefault("reminders", [])
        low_args = args.lower()
        if low_args == "clear":
            kept = [item for item in reminders if item.get("done")]
            cleared = len(reminders) - len(kept)
            engine.memory["reminders"] = kept
            save_memory(engine.memory_path, engine.memory)
            print("Cleared %d pending reminder(s)." % cleared)
            engine._audit("Memory", "remind clear", "Success")
