    def learning_entry(self, subject: str) -> Tuple[Dict[str, Any], Optional[str]]:
        """Return (entry, evicted_subject_or_None) for `subject`.

        Creates the entry on first use, enforcing the 20-subject cap by
        evicting the oldest-started subject (the caller prints the
        eviction notice).
        """
        learning = self.memory.setdefault("learning", {})
        evicted = None
        if subject not in learning:
            if len(learning) >= MAX_LEARNING_SUBJECTS:
                oldest = min(
                    learning,
                    key=lambda s: (str(learning[s].get("started", "")),
                                   str(learning[s].get("last_session", ""))),
                )
                del learning[oldest]
                evicted = oldest
            learning[subject] = {
                "syllabus": [],
                "current_lesson": 0,
                "quiz_scores": [],
                "weak_points": [],
                "started": utc_now_iso(),
                "last_session": "",
            }
        return learning[subject], evicted

    def _llm_syllabus(self, subject: str) -> Optional[List[Dict[str, Any]]]:
        """Ask the LLM for a 10-lesson outline; None on any failure.

        Expected per-line format: "Lesson N: title | point | point | point".
        Parsing is tolerant; fewer than 5 usable lessons -> None so the
        caller falls back to the offline outline.
        """
        reply = self._llm_messages([
            {"role": "system", "content": PROFESSOR_PROMPT % subject},
            {"role": "user", "content": (
                "Write a 10-lesson leveled course outline for %s, from "
                "foundations to a capstone. Reply with EXACTLY 10 lines, "
                "one per lesson, in this format:\n"
                "Lesson N: <title> | <key point> | <key point> | "
                "<key point>\nNo other text." % subject)},
        ], max_tokens=1200)
        if not reply:
            return None
        lessons: List[Dict[str, Any]] = []
        try:
            for raw_line in reply.splitlines():
                line = raw_line.strip()
                if not line:
                    continue
                # Strip "Lesson N:" / "N." / "N)" style prefixes.
                line = re.sub(r"^(lesson\s*)?\d+\s*[:.\)]\s*", "",
                              line, flags=re.IGNORECASE).strip()
                if not line:
                    continue
                if "|" in line:
                    parts = [p.strip() for p in line.split("|")]
                    title, points = parts[0], [p for p in parts[1:] if p]
                elif " - " in line:
                    parts = [p.strip() for p in line.split(" - ")]
                    title, points = parts[0], [p for p in parts[1:] if p]
                else:
                    title, points = line, []
                if title:
                    lessons.append({"title": title,
                                    "points": (points + ["", "", ""])[:3]})
            if len(lessons) < 5:
                return None
            return lessons[:10]
        except Exception:
            return None

    def get_syllabus(self, subject: str,
                     regenerate: bool = False) -> Tuple[List[Dict[str, Any]],
                                                        Optional[str], str]:
        """Return (syllabus, evicted, source) for `subject`.

        source is 'saved', 'llm', 'builtin' or 'scaffold'. A saved
        syllabus is reused unless regenerate=True; a fresh one is LLM-
        generated when online, else the built-in outline (or the generic
        mastery scaffold for unknown subjects). Persisted on change.
        """
        subject = normalize_subject(subject)
        entry, evicted = self.learning_entry(subject)
        if entry.get("syllabus") and not regenerate:
            return entry["syllabus"], evicted, "saved"
        syllabus = None
        source = "builtin"
        if self.openai_key:
            syllabus = self._llm_syllabus(subject)
            if syllabus:
                source = "llm"
        if syllabus is None:
            builtin = BUILTIN_SYLLABI.get(subject)
            if builtin:
                syllabus = [{"title": t, "points": list(p)}
                            for t, p in builtin]
                source = "builtin"
            else:
                syllabus = generic_scaffold(subject)
                source = "scaffold"
        entry["syllabus"] = syllabus
        entry["current_lesson"] = min(int(entry.get("current_lesson", 0)),
                                      max(0, len(syllabus) - 1))
        save_memory(self.memory_path, self.memory)
        return syllabus, evicted, source

    def record_quiz_score(self, subject: str, score: int, total: int) -> None:
        """Append a graded quiz result to the learner profile and save."""
        subject = normalize_subject(subject)
        entry, _evicted = self.learning_entry(subject)
        entry.setdefault("quiz_scores", []).append({
            "ts": utc_now_iso(),
            "score": int(score),
            "total": int(total),
        })
        entry["last_session"] = utc_now_iso()
        save_memory(self.memory_path, self.memory)

    def add_weak_point(self, subject: str, point: str) -> None:
        """Track a question the student marked wrong (dedup, cap 20)."""
        subject = normalize_subject(subject)
        entry, _evicted = self.learning_entry(subject)
        weak = entry.setdefault("weak_points", [])
        point = str(point).strip()
        if point and point not in weak:
            weak.append(point)
            del weak[:-20]

