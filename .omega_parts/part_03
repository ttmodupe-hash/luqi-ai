def _cap_messages(messages: List[Dict[str, str]],
                  limit: int = MAX_TEACH_MESSAGES) -> List[Dict[str, str]]:
    """Cap a chat message list at `limit`, preserving the system message."""
    if len(messages) <= limit:
        return list(messages)
    head: List[Dict[str, str]] = []
    if messages and messages[0].get("role") == "system":
        head = [messages[0]]
    keep = max(1, limit - len(head))
    return head + list(messages[-keep:])


