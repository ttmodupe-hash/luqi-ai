            chunks = doc.get("chunks") or []
            if not isinstance(chunks, list):
                chunks = []
            try:
                chars = int(doc.get("chars") or 0)
            except Exception:
                chars = 0
            print("%-2d %-20s %6d %8d  %s"
                  % (idx, str(doc.get("name", "?"))[:20], len(chunks),
                     chars, str(doc.get("ts", ""))[:10]))
        total = sum(len(d.get("chunks") or []) for d in docs
                    if isinstance(d.get("chunks") or [], list))
        print("%d documents, %d chunks (max %d docs / %d chunks)"
              % (len(docs), total, MAX_DOCUMENTS, MAX_TOTAL_CHUNKS))
        engine._audit("CLI", "docs", "Success")
        return True
    if lowered == "ask" or lowered.startswith("ask "):
        question = line[len("ask"):].strip()
        if not question:
            print("Usage: ask <question>   (or: ask save; web fallback "
                  "when SERPER_API_KEY set)")
            engine._audit("CLI", "ask (no question)", "Failed")
            return True
        if question.lower() == "save":
            last = getattr(engine, "_last_answer", None)
            if not last:
                print("no answer to save yet")
                engine._audit("CLI", "ask save", "Failed")
                return True
            try:
                stamp = datetime.now(timezone.utc).strftime(
                    "%Y%m%dT%H%M%SZ")
                filename = "omega_answer_%s_%s.md" % (
                    _slugify(str(last.get("q", "question"))), stamp)
                answer_lines = [
                    "# Answer: %s" % last.get("q", ""),
                    "",
                    "Generated: %s (UTC)" % utc_now_iso(),
                    "Engine: " + ENGINE_NAME,
                    "",
                    "## Question",
                    str(last.get("q", "")),
                    "",
                    "## Answer",
                    str(last.get("text", "")),
                    "",
                    "## Sources",
                ]
                sources = last.get("sources") or []
                if sources:
                    answer_lines.extend("- " + str(s) for s in sources)
                else:
                    answer_lines.append("- (none)")
                answer_lines.append("")
                with open(filename, "w", encoding="utf-8") as handle:
                    handle.write("\n".join(answer_lines))
                print("saved: %s" % filename)
                engine._audit("CLI", "ask save", "Success")
            except Exception as exc:
                print("answer save failed safely: %s" % exc)
                engine._audit("CLI", "ask save", "Failed")
            return True
        docs = [d for d in engine.memory.setdefault("documents", [])
                if isinstance(d, dict)]
        if not docs:
            web = _ask_web_fallback(engine, question)
            if web:
                print(web["text"])
                if web["sources"]:
                    print()
                    print("sources: " + ", ".join(web["sources"]))
                engine._last_answer = {"q": question, "text": web["text"],
                                       "sources": web["sources"],
                                       "ts": utc_now_iso()}
                engine._audit("CLI", "ask %s (web)" % question[:60],
                              "Success")
                return True
            print("no documents yet - ingest <path> first")
            print("set SERPER_API_KEY in .env for web-backed answers")
            engine._audit("CLI", "ask %s" % question[:60], "Failed")
            return True
        hits = search_documents(question, docs)
        if not hits:
            web = _ask_web_fallback(engine, question)
            if web:
                print(web["text"])
                if web["sources"]:
                    print()
                    print("sources: " + ", ".join(web["sources"]))
                engine._last_answer = {"q": question, "text": web["text"],
                                       "sources": web["sources"],
                                       "ts": utc_now_iso()}
                engine._audit("CLI", "ask %s (web)" % question[:60],
                              "Success")
                return True
            print("no relevant passages - try different words")
            print("documents: " + ", ".join(
                str(d.get("name", "?")) for d in docs))
            print("set SERPER_API_KEY in .env for web-backed answers")
            engine._audit("CLI", "ask %s" % question[:60], "Failed")
            return True
        passages = []
        for num, (_score, name, chunk_idx, chunk) in enumerate(hits, 1):
            passages.append("[%d] (%s #%d) %s"
                            % (num, name, chunk_idx, chunk))
        block = "\n".join(passages)
        try:
            reply = engine._llm_messages([
                {"role": "system",
                 "content": ("Answer ONLY from the provided passages. "
                             "Cite sources like [name]. If the passages "
                             "do not answer, say so briefly.")},
                {"role": "user",
                 "content": question + "\n\nPassages:\n" + block},
            ])
        except Exception:
            reply = None
        sources = ["%s #%d" % (name, chunk_idx)
                   for _s, name, chunk_idx, _c in hits]
        if reply:
            answer_text = reply.strip()
            print(answer_text)
            print()
            print("sources: " + ", ".join(sources))
        else:
            print("offline mode - top passages:")
            offline_lines = []
            for num, (_score, name, chunk_idx, chunk) in enumerate(
                    hits, 1):
                shown = chunk if len(chunk) <= 600 else chunk[:600] + "..."
                offline_lines.append("[%d] (%s #%d) %s"
                                     % (num, name, chunk_idx, shown))
            answer_text = "\n".join(offline_lines)
            print(answer_text)
            print("set OPENAI_API_KEY in .env for synthesized answers")
        engine._last_answer = {"q": question, "text": answer_text,
                               "sources": sources, "ts": utc_now_iso()}
        engine._audit("CLI", "ask %s" % question[:60], "Success")
        return True

    # --- v29.12.0 commands (Prompt Forge) ---
    # Offline expert-prompt compiler. The draft session lives at
    # memory["prompt_forge"] (optional key - no fresh_memory default).
    # Reserved sub-words: add/show/run/save/clear. An idea whose first
    # token is exactly a reserved word triggers that sub-command instead.
    if lowered == "prompt" or lowered.startswith("prompt "):
        arg = line[len("prompt"):].strip()
        forge = engine.memory.get("prompt_forge")
        if not isinstance(forge, dict):
            forge = None
        if not arg:
            print("Usage: prompt <idea>   (then: prompt add <req> | "
                  "prompt show | prompt run | prompt save | prompt clear)")
            if forge:
                idea = str(forge.get("idea", ""))
                excerpt = idea if len(idea) <= 60 else idea[:57] + "..."
                adds = forge.get("adds") or []
                print("draft: \"%s\" | adds: %d | started: %s"
                      % (excerpt, len(adds), str(forge.get("ts", ""))))
            else:
                print("no draft - start with: prompt <your idea>")
            engine._audit("CLI", "prompt", "Success")
            return True
        first = arg.split(None, 1)[0].lower()
        rest = arg[len(first):].strip()
        if first == "add":
            if not forge:
                print("no prompt draft - start with: prompt <your idea>")
                engine._audit("CLI", "prompt add", "Failed")
                return True
            if not rest:
                print("Usage: prompt add <requirement>")
                engine._audit("CLI", "prompt add", "Failed")
                return True
            adds = forge.get("adds")
            if not isinstance(adds, list):
                adds = []
                forge["adds"] = adds
            adds.append(rest)
            print("## Injected requirements")
            for entry in adds:
                print("- " + str(entry))
            tips = _prompt_gaps(str(forge.get("idea", "")) + " "
                                + " ".join(str(a) for a in adds))
            print("coaching tips remaining: %d" % len(tips))
            save_memory(engine.memory_path, engine.memory)
            engine._audit("CLI", "prompt add %s" % rest[:60], "Success")
            return True
        if first == "