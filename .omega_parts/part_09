def _parse_remind_when(arg: str) -> Optional[datetime]:
    """Parse 'in <N>m|h|d' or 'at HH:MM' into a due datetime (None if bad)."""
    try:
        text = (arg or "").strip().lower()
        now = datetime.now()
        match = re.fullmatch(r"in\s+(\d+)\s*([mhd])", text)
        if match:
            amount = int(match.group(1))
            seconds = {"m": 60, "h": 3600, "d": 86400}[match.group(2)]
            return now + timedelta(seconds=amount * seconds)
        match = re.fullmatch(r"at\s+(\d{1,2}):(\d{2})", text)
        if match:
            hour, minute = int(match.group(1)), int(match.group(2))
            if hour > 23 or minute > 59:
                return None
            due = now.replace(hour=hour, minute=minute,
                              second=0, microsecond=0)
            if due <= now:  # time already passed today -> tomorrow
                due = due + timedelta(days=1)
            return due
        return None
    except Exception:
        return None


def _due_reminders(engine: OmegaMasterEngine) -> List[str]:
    """Texts of due-and-undone reminders; marks them done + saves memory.

    Runs at REPL start and at the top of every command - never raises.
    """
    fired: List[str] = []
    try:
        reminders = engine.memory.setdefault("reminders", [])
        now = datetime.now()
        changed = False
        for item in reminders:
            try:
                if item.get("done"):
                    continue
                due = datetime.strptime(str(item.get("due", "")),
                                        "%Y-%m-%d %H:%M")
                if due <= now:
                    item["done"] = True
                    changed = True
                    fired.append(str(item.get("text", "")))
            except Exception:
                continue
        if changed:
            save_memory(engine.memory_path, engine.memory)
    except Exception:
        pass
    return fired


def _voice_out(engine: OmegaMasterEngine, base_out: Any) -> Any:
    """Wrap a classroom out= callable: print, then speak when voice is on.

    Windows: synthesize to omega_voice_last.mp3 (overwritten) and auto-play
    it. Other platforms: one-time notice on the first line, then print-only.
    Every failure degrades to print-only (never raises).
    """
    if not engine.memory.setdefault("voice_enabled", False):
        return base_out
    state = {"noticed": False}

    def wrapped(line: Any = "") -> None:
        text = str(line)
        base_out(text)
        try:
            if sys.platform != "win32":
                if not state["noticed"]:
                    state["noticed"] = True
                    base_out("(voice playback auto-plays on Windows; "
                             "mp3 saved)")
                return
            data = e