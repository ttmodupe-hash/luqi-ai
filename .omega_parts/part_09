        engine._audit("Memory", "recall", "Success")
        return True
    if lowered == "forget" or lowered.startswith("forget "):
        arg = line[len("forget"):].strip()
        # v29.7.0: 'forget doc <name>' removes an ingested document
        # (handled here because bare 'forget <n>' claims the prefix).
        if arg.lower() == "doc" or arg.lower().startswith("doc "):
            name = arg[len("doc"):].strip()
            if not name:
                print("Usage: forget doc <name>")
                engine._audit("CLI", "forget doc (no name)", "Failed")
                return True
            docs = engine.memory.setdefault("documents", [])
            match = None
            for doc in docs:
                if (isinstance(doc, dict)
                        and str(doc.get("name", "")).lower()
                        == name.lower()):
                    match = doc
                    break
            if match is None:
                print("no document named %s" % name)
                engine._audit("CLI", "forget doc %s" % name, "Failed")
                return True
            docs.remove(match)
            save_memory(engine.memory_path, engine.memory)
            print("forgot document: %s" % match.get("name", name))
            engine._audit("CLI", "forget doc %s" % name, "Success")
            return True
        try:
            index = int(arg)
        except ValueError:
            print("Usage: forget <number>  (see 'recall' for numbers)")
            return True
        removed = engine.forget_fact(index)
        if removed is None:
            print("No fact #%d. Use 'recall' to list numbered facts." % index)
        else:
            print(engine.ui_format("forgot", index, removed))
        engine._audit("Memory", "forget %s" % arg, "Success")
