def _tokenize(text: str) -> List[str]:
    """Lowercase word tokens (a-z0-9) for retrieval scoring."""
    return re.findall(r"[a-z0-9]+", (text or "").lower())


def _chunk_text(text: str, max_chars: int = DOC_CHUNK_CHARS) -> List[str]:
    """Split text into <= max_chars chunks on blank-line paragraphs.

    Paragraphs pack greedily (joined by a blank line); a paragraph longer
    than max_chars is hard-split into max_chars pieces. Empty input -> [].
    """
    try:
        max_chars = max(1, int(max_chars or DOC_CHUNK_CHARS))
    except Exception:
        max_chars = DOC_CHUNK_CHARS
    paragraphs = [p.strip() for p in re.split(r"\n\s*\n", text or "")]
    paragraphs = [p for p in paragraphs if p]
    chunks: List[str] = []
    current = ""
    for para in paragraphs:
        while len(para) > max_chars:
            # Hard-split an oversize paragraph into max_chars pieces.
            if current:
                chunks.append(current)
                current = ""
            chunks.append(para[:max_chars])
            para = para[max_chars:]
        candidate = (current + "\n\n" + para) if current else para
        if current and len(candidate) > max_chars:
            chunks.append(current)
            current = para
        else:
            current = candidate
    if current:
        chunks.append(current)
    return chunks


def _score_chunk(query_tokens: List[str], chunk: str) -> int:
    """Token-overlap score: summed per-token frequency in the chunk."""
    chunk_tokens = _tokenize(chunk)
    score = 0
    for tok in set(query_tokens or []):
        score += chunk_tokens.count(tok)
    return score


def _idf_scores(docs: List[Dict[str, Any]]) -> Dict[str, float]:
    """Smoothed inverse-document-frequency over every stored chunk.

    idf(t) = math.log(1.0 + (N + 1.0) / (df + 1.0)) where N is the total
    chunk count and df the number of chunks containing t. Rare terms score
    high, corpus-common terms sink. Never raises; empty corpus -> {}.
    """
    try:
        chunk_texts: List[str] = []
        for doc in docs or []:
            try:
                if not isinstance(doc, dict):
                    continue
                chunks = doc.get("chunks") or []
                if not isinstance(chunks, list):
                    continue
                for chunk in chunks:
                    if isinstance(chunk, str) and chunk:
                        chunk_texts.append(chunk)
            except Exception:
                continue
        total = len(chunk_texts)
        if not total:
            return {}
        df: Dict[str, int] = {}
        for chunk in chunk_texts:
            for tok in set(_tokenize(chunk)):
                df[tok] = df.get(tok, 0) + 1
        return {tok: math.log(1.0 + (total + 1.0) / (count + 1.0))
                for tok, count in df.items()}
    except Exception:
        return {}


def search_documents(query: str, docs: List[Dict[str, Any]],
                     top_k: int = DOC_TOP_K
                     ) -> List[Tuple[float, str, int, str]]:
    """Rank document chunks by IDF-weighted token overlap. Never raises.

    v29.8.0: each unique query token contributes idf(t) * log(1 + tf)
    in the chunk, with idf from _idf_scores(docs) - rare decisive terms
    outrank repeated common ones (sublinear term-frequency stops a chunk
    repeating a corpus-common word from beating the rare-term chunk).
    Returns (score, doc_name, chunk_index, chunk_text) with score > 0,
    best first, ties broken toward shorter chunks, truncated to top_k.
    """
    hits: List[Tuple[float, str, int, str]] = []
    try:
        query_tokens = _tokenize(query)
        if not query_tokens or not isinstance(docs, list):
            return hits
        idf = _idf_scores(docs)
        for doc in docs:
            try:
                if not isinstance(doc, dict):
                    continue
                name = str(doc.get("name", "?"))
                chunks = doc.get("chunks") or []
                if not isinstance(chunks, list):
                    continue
                for idx, chunk in enumerate(chunks):
                    if not isinstance(chunk, str):
                        continue
                    chunk_tokens = _tokenize(chunk)
                    score = 0.0
                    for tok in set(query_tokens):
                        score += (idf.get(tok, 0.0)
                                  * math.log(1.0 + chunk_tokens.count(tok)))
                    if score > 0:
                        hits.append((score, name, idx, chunk))
            except Exception:
                continue
        hits.sort(key=lambda hit: (-hit[0], len(hit[3])))
        return hits[:max(0, int(top_k))]
    except Exception:
        return []


class _TextExtractor(HTMLParser):
    """Collect visible page text; skip script/style/noscript/head."""

    _SKIP_TAGS = {"script", "style", "noscript", "head"}
    _BLOCK_TAGS = {"p", "div", "br", "li", "tr", "table", "section",
                   "article", "header", "footer", "h1", "h2", "h3",
                   "h4", "h5", "h6"}

    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self._skip = 0
        self.parts: List[str] = []

    def handle_starttag(self, tag: str, attrs: Any) -> None:
        if tag in self._SKIP_TAGS:
            self._skip += 1
        elif tag in self._BLOCK_TAGS:
            self.parts.append("\n")

    def handle_endtag(self, tag: str) -> None:
        if tag in self._SKIP_TAGS and self._skip:
            self._skip -= 1
        elif tag in self._BLOCK_TAGS:
            self.parts.append("\n")

    def handle_data(self, data: str) -> None:
        if not self._skip and data:
            self.parts.append(data)


def _html_to_text(html_text: str) -> str:
    """HTML -> plain text. Entities unescaped, whitespace normalized.

    Block tags become newlines, runs of spaces collapse, more than two
    consecutive blank lines become one. Never raises; "" on bad input.
    """
    try:
        extractor = _TextExtractor()
        extractor.feed(html_text or "")
        extractor.close()
        raw = "".join(extractor.parts)
        raw = re.sub(r"[ \t\r\f\v]+", " ", raw)
        raw = re.sub(r" *\n *", "\n", raw)
        raw = re.sub(r"\n{3,}", "\n\n", raw)
        return raw.strip()
    except Exception:
        return ""


