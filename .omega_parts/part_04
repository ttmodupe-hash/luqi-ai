                v_text = None
                for child in cell_el:
                    if _xlsx_localname(child.tag) == "v":
                        v_text = child.text
                        break
                if v_text is not None:
                    if cell_type == "s":
                        try:
                            value = shared[int(v_text)]
                        except Exception:
                            value = v_text
