            urllib.request.urlopen = orig_urlopen
            offline_engine.openai_key = orig_key
            if had_speed:
                offline_engine.memory["voice_speed"] = orig_speed
            else:
                offline_engine.memory.pop("voice_speed", None)
    except Exception as exc:
        checks.append(("v29.11: tts payload (exception: %s)" % exc, False))

    # C3: explicit tts speed arg is clamped (urlopen monkeypatched).
    try:
        captured_clamp: Dict[str, Any] = {}
        orig_urlopen = urllib.request.urlopen
        orig_key = offline_engine.openai_key

        class _FakeClampResp(object):
            def read(self):
                return b"mp3"

            def __enter__(self):
                return self

            def __exit__(self, *args):
                return False

        def _clamp_urlopen(request, timeout=None, **kwargs):
            captured_clamp["json"] = json.loads(
                request.data.decode("utf-8", errors="replace"))
            return _FakeClampResp()

        try:
            urllib.request.urlopen = _clamp_urlopen
            offline_engine.openai_key = "x"
            data = offline_engine._tts_speech("hi", speed=99)
            checks.append(("v29.11: explicit tts speed clamped",
                           data == b"mp3"
                           and captured_clamp.get("json", {}).get("speed")
                           == 4.0))
        finally:
            urllib.request.urlopen = orig_urlopen
            offline_engine.openai_key = orig_key
    except Exception as exc:
        checks.append(("v29.11: tts speed clamp (exception: %s)" % exc,
                       False))

    # Router: traffic/violation phrases -> rights driving guide only.
    try:
        result = engine.execute_omega_subsystem(
            "what about a speeding fine",
            {"query": "what about a speeding fine"})
        checks.append(("v29.11: router sends speeding phrase to rights",
                       result.get("subsystem") == "Omega Rights & Travel"
                       and result.get("guide") == "driving_sa"
                       and "not legal advice" in result.get(
                           "disclaimer", "")))
        result = engine.execute_omega_subsystem(
            "speeding ticket costs", {"query": "speeding ticket costs"})
        checks.append(("v29.11: speeding ticket -> driving_sa guide",
                       result.get("subsystem") == "Omega Rights & Travel"
                       and result.get("guide") == "driving_sa"))
        result = engine.execute_omega_subsystem(
            "define fine art", {"query": "define fine art"})
        checks.append(("v29.11: router control phrase stays clear",
                       result.get("subsystem") != "Omega Rights & Travel"
                       and "guide" not in result))
    except Exception as exc:
        checks.append(("v29.11: router keywords (exception: %s)" % exc,
                       False))

    # docx/xlsx fixtures never raise (tempfile only, no network).
    try:
        with tempfile.TemporaryDirectory() as tmpdir:
            empty_docx = os.path.join(tmpdir, "empty.docx")
            with zipfile.ZipFile(empty_docx, "w") as archive:
                archive.writestr("word/document.xml", b"")
            nodoc_docx = os.path.join(tmpdir, "nodoc.docx")
            with zipfile.ZipFile(nodoc_docx, "w") as archive:
                archive.writestr("word/other.xml", b"<x/>")
            random_docx = os.path.join(tmpdir, "random.docx")
            with open(random_docx, "wb") as handle:
                handle.write(os.urandom(100))
            results = (_docx_to_text(empty_docx),
                       _docx_to_text(nodoc_docx),
                       _docx_to_text(random_docx))
        checks.append(("v29.11: docx fixtures never raise, return ''",
                       results == ("", "", "")))
    except Exception as exc:
        checks.append(("v29.11: docx fixtures (exception: %s)" % exc,
                       False))

    # Report.
    failures = 0
    for name, ok in checks:
        print("  [%s] %s" % ("PASS" if ok else "FAIL", name))
        if not ok:
            failures += 1
    print("-" * 60)
    print("%d/%d checks passed." % (len(checks) - failures, len(checks)))
    if failures:
        print("SELF TEST: FAIL")
        return 1
    print("SELF TEST: PASS")
    return 0


