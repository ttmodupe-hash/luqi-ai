def lesson_intro_lines(entry: Dict[str, Any], subject: str) -> List[str]:
    """Render the current lesson (title + key points) for a profile entry."""
    syllabus = entry.get("syllabus") or []
    if not syllabus:
        return ["No syllabus yet for %s - type 'syllabus' to build one."
                % subject]
    try:
        idx = int(entry.get("current_lesson", 0))
    except Exception:
        idx = 0
    idx = min(max(0, idx), len(syllabus) - 1)
    lesson = syllabus[idx]
    lines = ["Lesson %d/%d: %s" % (idx + 1, len(syllabus),
                                   lesson.get("title", "?"))]
    for point in lesson.get("points") or []:
        lines.append("  - " + str(point))
    return lines


def syllabus_lines(engine: OmegaMasterEngine, subject: str,
                   regenerate: bool = False) -> List[str]:
    """Render a subject's 10-lesson outline (LLM online, offline built-in)."""
    subject = normalize_subject(subject)
    syllabus, evicted, source = engine.get_syllabus(subject, regenerate)
    lines: List[str] = []
    if evicted:
        lines.append("Note: learner profile full (%d subjects) - oldest "
                     "subject '%s' was evicted."
                     % (MAX_LEARNING_SUBJECTS, evicted))
    label = {
        "saved": "saved syllabus",
        "llm": "LLM-generated outline",
        "builtin": "built-in outline",
        "scaffold": "generic mastery scaffold",
    }.get(source, source)
    lines.append("Syllabus for %s (%s, %d lessons):"
                 % (subject, label, len(syllabus)))
    for i, lesson in enumerate(syllabus, 1):
        lines.append("  Lesson %d: %s" % (i, lesson.get("title", "?")))
        for point in (lesson.get("points") or [])[:3]:
            lines.append("    - " + str(point))
    if source == "scaffold":
        lines.append("(Generic scaffold - add OPENAI_API_KEY for a custom "
                     "LLM-generated outline.)")
    lines.append("Regenerate with: syllabus %s new" % subject)
    return lines


def progress_lines(engine: OmegaMasterEngine) -> List[str]:
    """Render the learner-profile table (empty + populated states)."""
    learning = engine.memory.get("learning") or {}
    if not learning:
        return ["No learning progress yet.",
                "Start a class with: teach <subject>  "
                "(e.g. teach mathematics)"]
    lines = ["Learner progress (%d subject%s):"
             % (len(learning), "" if len(learning) == 1 else "s")]
    lines.append("  %-18s %-9s %-9s %-6s %s"
                 % ("Subject", "Lesson", "Avg quiz", "Weak", "Last session"))
    for subject in sorted(learning):
        entry = learning[subject] or {}
        syllabus = entry.get("syllabus") or []
        total_lessons = len(syllabus) or 10
        try:
            current = int(entry.get("current_lesson", 0)) + 1
        except Exception:
            current = 1
        lesson_txt = "%d/%d" % (min(current, total_lessons), total_lessons)
        scores = entry.get("quiz_scores") or []
        pcts = [100.0 * s.get("score", 0) / s.get("total", 1)
                for s in scores if s.get("total")]
        avg_txt = ("%d%%" % round(sum(pcts) / len(pcts))) if pcts else "-"
        weak = entry.get("weak_points") or []
        last = str(entry.get("last_session") or "")[:10] or "-"
        lines.append("  %-18s %-9s %-9s %-6d %s"
                     % (str(subject)[:18], lesson_txt, avg_txt,
                        len(weak), last))
    return lines


def run_offline_quiz(engine: OmegaMasterEngine, subject: str,
                     input_fn: Any, out: Any
                     ) -> Tuple[Optional[int], int, Optional[str]]:
    """Offline self-check quiz.

    Shows built-in questions one by one; 'reveal' shows the answer, then
    the student self-marks 'right'/'wrong'. Returns (score, asked,
    leftover_line) where leftover_line is an intercepted classroom command
    that ended the quiz early (to be processed by the session loop).
    (None, 0, None) when no bank exists for the subject.
    """
    subject = normalize_subject(subject)
    bank = OFFLINE_QUIZ_BANKS.get(subject)
    if not bank:
        out("No offline quiz bank for '%s' yet - add OPENAI_API_KEY for "
            "generated quizzes." % subject)
        return None, 0, None
    out("Offline self-check quiz: %d cards. For each: think, type "
        "'reveal', then mark 'right' or 'wrong'." % len(bank))
    score = 0
    asked = 0
    for qnum, (question, answer) in enumerate(bank, 1):
        out("Q%d: %s" % (qnum, question))
        revealed = False
        while True:
            try:
                raw = input_fn("[QUIZ] > ")
            except EOFError:
                out("")
                out("(End of input - closing the quiz.)")
                return score, asked, None
            except KeyboardInterrupt:
                out("")
                continue
            cmd = raw.strip().lower()
            if not cmd:
                continue
            if cmd in ("end class", "next", "progress", "syllabus",
                       "hint", "quiz me", "exit", "quit"):
                out("Quiz ended early (%d card%s marked)."
                    % (asked, "" if asked == 1 else "s"))
                return score, asked, raw.strip()
            if not revealed:
                if cmd == "reveal":
                    out("Answer: %s" % answer)
                    out("Be honest - mark 'right' or 'wrong'.")
                    revealed = True
                else:
                    out("Think first, then type 'reveal' to see the "
                        "answer.")
            else:
                if cmd == "right":
                    score += 1
                    asked += 1
                    out("Marked right. Well done.")
                    break
                if cmd == "wrong":
                    asked += 1
                    engine.add_weak_point(subject, question)
                    out("Marked wrong - noted as a weak point to review.")
                    break
                if cmd == "reveal":
                    out("Answer: %s" % answer)
                else:
                    out("Type 'right' or 'wrong' (or 'reveal' to see the "
                        "answer again).")
    out("Self-check complete: %d/%d correct." % (score, asked))
    return score, asked, None


def run_online_quiz(engine: OmegaMasterEngine, subject: str,
                    messages: List[Dict[str, str]], input_fn: Any,
                    out: Any) -> Optional[Tuple[int, int]]:
    """Online 3-question graded exchange with the professor.

    Returns (score, total) or None when the LLM is unreachable before
    the first question (caller falls back to the offline self-check).
    """
    convo = list(messages)
    score = 0
    asked = 0
    for i in range(3):
        convo.append({"role": "user", "content": (
            "Quiz time: ask me question %d of 3 about %s. Ask ONLY the "
            "question, do not give the answer." % (i + 1, subject))})
        convo = _cap_messages(convo)
        question = engine._llm_messages(convo)
        if not question:
            return (score, asked) if asked else None
        question = question.strip()
        out("Professor asks: %s" % question)
        convo.append({"role": "assistant", "content": question})
        try:
            answer = input_fn("[QUIZ] > ")
        except EOFError:
            out("")
            return (score, asked) if asked else None
        except KeyboardInterrupt:
            out("")
            return (score, asked) if asked else None
        convo.append({"role": "user", "content": answer.strip()})
        convo.append({"role": "user", "content": (
            "Grade my answer strictly. Start your reply with RIGHT or "
            "WRONG, then one short line of feedback.")})
        convo = _cap_messages(convo)
        grading = engine._llm_messages(convo)
        asked += 1
        if not grading:
            out("(Grading unavailable - LLM call failed; this question "
                "was not scored.)")
            continue
        grading = grading.strip()
        convo.append({"role": "assistant", "content": grading})
        out("Professor: %s" % grading)
        if grading.upper().startswith("RIGHT"):
            score += 1
        else:
            engine.add_weak_point(subject, question[:80])
    out("Professor's grade: %d/%d." % (score, asked))
    if score < asked:
        out("Review the questions marked wrong before the next class.")
    return score, asked


def teach_session(engine: OmegaMasterEngine, subject: str,
                  input_fn: Any = input, out: Any = print) -> None:
    """Run one tutor session (sub-REPL) for `subject`.

    ONLINE: multi-turn professor conversation with the full rolling
    context (capped at the last 40 messages) through _llm_messages.
    OFFLINE: one honest 'needs key' line, then the offline classroom
    (built-in syllabus lessons + self-check quiz). NEVER fakes a
    conversation and NEVER crashes; EOF/KeyboardInterrupt safe.
    """
    subject = normalize_subject(subject)
    if not subject:
        out("Usage: teach <subject>")
        return
    online = bool(engine.openai_key)
    syllabus, evicted, _source = engine.get_syllabus(subject)
    if evicted:
        out("Note: learner profile full (%d subjects) - oldest subject "
            "'%s' was evicted." % (MAX_LEARNING_SUBJECTS, evicted))
    entry, _ = engine.learning_entry(subject)
    out("=" * 60)
    out("CLASSROOM: %s with Professor LUQI" % subject)
    out("=" * 60)
    messages: List[Dict[str, str]] = []
    if online:
        messages.append({"role": "system",
                         "content": PROFESSOR_PROMPT % subject})
    else:
        out("Live professor conversation needs OPENAI_API_KEY - running "
            "offline classroom.")
    out("In class: end class | syllabus | quiz me | hint | progress | next")
    for line in lesson_intro_lines(entry, subject):
        _professor_out(out, line)

    turns = 0
    quiz_results: List[Tuple[int, int]] = []
    leftover: Optional[str] = None
    while True:
        try:
            if leftover is not None:
                raw = leftover
                leftover = None
            else:
                raw = input_fn("[CLASS:%s] > " % subject)
        except EOFError:
            out("")
            out("(End of input - closing the classroom safely.)")
            break
        except KeyboardInterrupt:
            out("")  # newline, then reprompt
            continue
        cmd = raw.strip().lower()
        if not cmd:
            continue

        if cmd == "end class":
            break
        if cmd == "syllabus":
            for line in syllabus_lines(engine, subject):
                out(line)
            continue
        if cmd == "progress":
            for line in progress_lines(engine):
                out(line)
            continue
        if cmd == "quiz me":
            graded: Optional[Tuple[int, int]] = None
            if online:
                graded = run_online_quiz(engine, subject, messages,
                                         input_fn, out)
                if graded is None:
                    out("Live quiz unavailable - switching to offline "
                        "self-check cards.")
            if graded is None:
                score, asked, leftover = run_offline_quiz(
                    engine, subject, input_fn, out)
                if asked:
                    graded = (score, asked)
            if graded is not None:
                engine.record_quiz_score(subject, graded[0], graded[1])
                out("Quiz score recorded: %d/%d." % graded)
                quiz_results.append(graded)
            continue
        if cmd == "hint":
            if online:
                messages.append({"role": "user", "content": (
                    "I am stuck. Re-explain the current point more "
                    "simply and give me a hint, not the full answer.")})
                messages = _cap_messages(messages)
                reply = engine._llm_messages(messages)
                if reply:
                    reply = reply.strip()
                    _professor_out(out, reply)
                    messages.append({"role": "assistant",
                                     "content": reply})
                else:
                    out("The professor is unreachable right now (LLM "
                        "call failed) - no hint was generated.")
                    for line in lesson_intro_lines(entry, subject):
                        out(line)
            else:
                lesson_lines = lesson_intro_lines(entry, subject)
                if len(lesson_lines) > 1:
                    out("Hint: focus on this key point first - "
                        + lesson_lines[1].strip(" -"))
                else:
                    out("Hint: re-read the lesson title and look up one "
                        "example.")
            continue
        if cmd == "next":
            if entry.get("current_lesson", 0) < len(syllabus) - 1:
                entry["current_lesson"] = int(
                    entry.get("current_lesson", 0)) + 1
                for line in lesson_intro_lines(entry, subject):
                    _professor_out(out, line)
                if online:
                    messages.append({"role": "user", "content": (
                        "Let's move to the next lesson: %s."
                        % syllabus[entry["current_lesson"]].get(
                            "title", ""))})
                    messages = _cap_messages(messages)
                    reply = engine._llm_messages(messages)
                    if reply:
                        reply = reply.strip()
                        _professor_out(out, reply)
                        messages.append({"role": "assistant",
                                         "content": reply})
                    else:
                        out("(Professor unreachable - showing the "
                            "offline key points above.)")
            else:
                out("You are on the final lesson - try 'quiz me' or "
                    "'end class'.")
            continue

        # Free text -> student turn.
        turns += 1
        if online:
            messages.append({"role": "user", "content": raw.strip()})
            messages = _cap_messages(messages)
            reply = engine._llm_messages(messages)
            if reply:
                reply = reply.strip()
                _professor_out(out, reply)
                messages.append({"role": "assistant", "content": reply})
            else:
                out("The professor is unreachable right now (LLM call "
                    "failed) - no reply was generated.")
                out("You can still use: syllabus | next | quiz me | "
                    "hint | progress | end class.")
        else:
            out("(Offline classroom: there is no live conversation "
                "without OPENAI_API_KEY.)")
            out("Review the current lesson key points:")
            for line in lesson_intro_lines(entry, subject):
                _professor_out(out, line)
            out("Type 'next' to advance, 'quiz me' to self-check, or "
                "'end class' to finish.")

    # Session close: summary + persist progress (always, even on EOF).
    entry["last_session"] = utc_now_iso()
    save_memory(engine.memory_path, engine.memory)
    out("-" * 60)
    out("Class summary - %s" % subject)
    out("  Turns this session: %d" % turns)
    total_lessons = len(syllabus) or 10
    out("  Lesson position: %d/%d"
        % (min(int(entry.get("current_lesson", 0)) + 1, total_lessons),
           total_lessons))
    if quiz_results:
        out("  Quiz scores this session: "
            + ", ".join("%d/%d" % q for q in quiz_results))
    else:
        out("  Quiz scores this session: none")
    out("Progress saved to your learner profile ('progress' to view).")
    engine._audit("Classroom", "teach %s" % subject, "Success")
    engine.add_history("assistant",
                       "Taught a %s class (%d turns)." % (subject, turns))


def run_standalone_quiz(engine: OmegaMasterEngine, subject: str,
                        input_fn: Any = input, out: Any = print) -> None:
    """Top-level 'quiz <subject>' command (online grading or self-check)."""
    subject = normalize_subject(subject)
    if not subject:
        out("Usage: quiz <subject>   (inside a class, just say 'quiz me')")
        return
    graded: Optional[Tuple[int, int]] = None
    if engine.openai_key:
        graded = run_online_quiz(
            engine, subject,
            [{"role": "system", "content": PROFESSOR_PROMPT % subject}],
            input_fn, out)
        if graded is None:
            out("Live quiz unavailable - switching to offline "
                "self-check cards.")
    if graded is None:
        score, asked, leftover = run_offline_quiz(engine, subject,
                                                  input_fn, out)
        if leftover:
            out("(Ignored outside a class: '%s')" % leftover)
        if asked:
            graded = (score, asked)
    if graded is not None:
        engine.record_quiz_score(subject, graded[0], graded[1])
        out("Quiz score recorded: %d/%d. See 'progress'." % graded)


def study_session(engine: OmegaMasterEngine, topic: str,
                  input_fn: Any = input, out: Any = print) -> None:
    """Study your own documents with the professor. Never crashes.

    IDF retrieval picks the top passages for the topic; ONLINE the
    professor teaches and quizzes grounded in them, OFFLINE the passages
    print as honest study cards. Sub-commands: end study | passages |
    quiz me. EOF/KeyboardInterrupt safe.
    """
    topic = (topic or "").strip()
    docs = [d for d in engine.memory.setdefault("documents", [])
            if isinstance(d, dict)]
    if not docs:
        out("No documents yet - ingest <path-or-url> first, then study "
            "them.")
        return
    if not topic:
        out("Usage: study <topic>")
        out("documents: " + ", ".join(
            str(d.get("name", "?"))[:24] for d in docs[:6]))
        return
    hits = search_documents(topic, docs, top_k=5)
    if not hits:
        out("No passages match '%s' - try different words or ingest "
            "more." % topic)
        out("documents: " + ", ".join(str(d.get("name", "?")) for d in docs))
        return
    passages = []
    for num, (_score, name, chunk_idx, chunk) in enumerate(hits, 1):
        passages.append("[%d] (%s #%d) %s" % (num, name, chunk_idx, chunk))
    block = "\n\n".join(passages)
    online = bool(engine.openai_key)
    out("=" * 60)
    out("STUDY: %s (%d passages from your documents)"
        % (topic, len(hits)))
    out("=" * 60)
    out("In study: end study | passages | quiz me")
    messages: List[Dict[str, str]] = []
    if online:
        messages.append({"role": "system",
                         "content": STUDY_PROMPT % (topic, block)})
        messages.append({"role": "user", "content": (
            "Start the study session: give me a short overview of what "
            "my material says about %s, then one question to check me."
            % topic)})
        messages = _cap_messages(messages)
        reply = engine._llm_messages(messages)
        if reply:
            reply = reply.strip()
            _professor_out(out, reply)
            messages.append({"role": "assistant", "content": reply})
        else:
            online = False
            out("(Professor unreachable - showing offline study cards "
                "instead.)")
    if not online:
        out("Offline study cards (set OPENAI_API_KEY for the live "
            "professor):")
        for line in passages:
            _professor_out(out, line)

    turns = 0
    while True:
        try:
            try:
                raw = input_fn("[STUDY:%s] > " % topic[:18])
            except TypeError:
                # Zero-arg input_fn (scripted iterators in tests).
                raw = input_fn()
        except EOFError:
            out("")
            out("(End of input - closing the study session safely.)")
            break
        except KeyboardInterrupt:
            out("")  # newline, then reprompt
            continue
        cmd = raw.strip().lower()
        if not cmd:
            continue
        if cmd == "end study":
            break
        if cmd == "passages":
            for line in passages:
                out(line)
            continue
        if cmd == "quiz me":
            if online:
                messages.append({"role": "user", "content": (
                    "Quiz me with questions from the material, one at a "
                    "time. Ask the first now.")})
                messages = _cap_messages(messages)
                reply = engine._llm_messages(messages)
                if reply:
                    reply = reply.strip()
                    _professor_out(out, reply)
                    messages.append({"role": "assistant",
                                     "content": reply})
                else:
                    out("The professor is unreachable right now - no "
                        "quiz was generated.")
            else:
                out("Self-check: pick any card above and explain it "
                    "aloud in your own words.")
            continue
        # Free text -> student turn.
        turns += 1
        if online:
            messages.append({"role": "user", "content": raw.strip()})
            messages = _cap_messages(messages)
            reply = engine._llm_messages(messages)
            if reply:
                reply = reply.strip()
                _professor_out(out, reply)
                messages.append({"role": "assistant", "content": reply})
            else:
                out("The professor is unreachable right now - try "
                    "'passages' or 'end study'.")
        else:
            out("(Offline: the professor needs OPENAI_API_KEY. Try "
                "'passages', 'quiz me', or 'end study'.)")

    engine._audit("Study", "study %s" % topic, "Success")
    engine.add_history("assistant",
                       "Studied '%s' (%d turns)." % (topic, turns))


