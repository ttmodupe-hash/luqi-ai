{
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "ops/Dockerfile.business-setup"
  },
  "deploy": {
    "runtime": "V2",
    "numReplicas": 1,
    "startCommand": "node /work/setup.js",
    "restartPolicyType": "NEVER",
    "multiRegionConfig": {
      "sfo": {
        "numReplicas": 1
      }
    }
  }
}
